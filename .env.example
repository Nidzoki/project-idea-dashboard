# Optional developer-only Gemini enrichment settings.
# Never commit a real API key; keep it in .env.local or the process environment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional NASA API credential for the Node-side collector. DEMO_KEY is used
# when this is empty; never expose a key to the frontend or commit a real key.
NASA_API_KEY=

# Optional Data.gov API credential. DEMO_KEY works for light collection.
DATAGOV_API_KEY=
